# Beispielkonfiguration - nach .env kopieren und Werte ändern
# SQL Server verlangt ein starkes Passwort (min. 8 Zeichen, Groß-/Kleinbuchstaben, Ziffern, Sonderzeichen)
SQL_SA_PASSWORD=Change-Me-Str0ng!Pass
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Mindestens 12 Zeichen, Groß-/Kleinbuchstaben, Ziffer, Sonderzeichen
BOOTSTRAP_ADMIN_PASSWORD=EinSicheres!Passwort123
# Standard-Kultur der Web-App (z. B. de-DE, en-US)
DEFAULT_CULTURE=de-DE
WEB_PORT=8080
# Host-Basispfad für Docker-Volumes (z. B. /srv/openhr-volumes)
HOST_VOLUMES_PATH=./.docker-data
