# Copy this file to .env and replace every placeholder with a unique secret.
# Do not commit the resulting .env file.

POSTGRES_DB=openhr
POSTGRES_USER=openhr
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

OPENHR_BOOTSTRAP_EMAIL=admin@example.com
OPENHR_BOOTSTRAP_DISPLAY_NAME=OpenHR Administrator
OPENHR_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-administrator-password

# Public origin of the PWA. Keep the default for local Docker Compose use.
WEB_ORIGIN=http://localhost:8081
