<div class="week">
    <CascadingValue Value="attendanceTypes">
        @for (int i = 0; i < 7; i++)
        {
            var currentDate = StartDate.AddDays(i);

            <CalendarWeekDay Date="currentDate" IsOtherMonth="!currentDate.Month.Equals(ViewMonth.Month)" />
        }
    </CascadingValue>
</div>

@code {
    [Parameter, EditorRequired]
    public DateOnly StartDate { get; set; }

    [Parameter, EditorRequired]
    public DateOnly ViewMonth { get; set; }


    [CascadingParameter]
    private List<AttendanceType>? attendanceTypes { get; set; }

}
