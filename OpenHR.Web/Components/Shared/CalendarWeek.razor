<div class="week">
    <CascadingValue Value="attendanceTypes">
        <CascadingValue Value="attendances">
            @for (int i = 0; i < 7; i++)
            {
                var currentDate = StartDate.AddDays(i);

                <CalendarWeekDay Date="currentDate"
                                 IsOtherMonth="!currentDate.Month.Equals(ViewMonth.Month)"
                                 AttendancesChanged="AttendancesChanged" />
            }
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    [Parameter, EditorRequired]
    public DateOnly StartDate { get; set; }

    [Parameter, EditorRequired]
    public DateOnly ViewMonth { get; set; }

    [Parameter]
    public EventCallback AttendancesChanged { get; set; }


    [CascadingParameter]
    private List<AttendanceType>? attendanceTypes { get; set; }

    [CascadingParameter]
    private List<Attendance>? attendances { get; set; }
}
