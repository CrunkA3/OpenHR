@using System.Globalization
@using Microsoft.FluentUI.AspNetCore.Components.Extensions

<div class="month-header">
    @for (int i = 0; i < 7; i++)
    {
        var currentDate = Monday.AddDays(i);
        <div class="month-header-day @currentDate.ToString("dddd", CultureInfo.InvariantCulture)">@currentDate.ToString("ddd", CultureInfo.CurrentCulture)</div>
    }
</div>

@code {
    private static readonly DateTime Monday = DateTime.Today.StartOfWeek();
}
