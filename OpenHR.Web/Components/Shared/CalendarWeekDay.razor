@using System.Globalization
@using Microsoft.EntityFrameworkCore;

@inject IDialogService DialogService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext

@inject ILogger<CalendarWeekDay> Logger

<div class="day @(IsOtherMonth ? "other-month" : "") @(IsToday ? "today" : "") @Date.ToString("dddd", CultureInfo.InvariantCulture)" @onclick="HandleDayClickAsync">
    <div class="date-short">@Date.ToString("dd", CultureInfo.CurrentCulture)</div>
    <div class="date-long">@Date.ToString("D", CultureInfo.CurrentCulture)</div>

    @foreach (var attendance in AttendancesForDay)
    {
        var attendanceShortName = attendance.AttendanceType?.AttendanceShortName ?? attendance.AttendanceTypeKey.ToString();

        <div class="attendance" title="@attendanceShortName"
             style="border-color: @(GetAttendanceColor(attendance));">
            @(attendance.ApplicationUser?.ShortName ?? attendance.ApplicationUser?.UserName)
        </div>
    }
</div>



@code {
    private string? currentUserId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [CascadingParameter]
    private List<AttendanceType>? attendanceTypes { get; set; }

    [CascadingParameter]
    private List<Attendance>? attendances { get; set; }

    private IEnumerable<Attendance> AttendancesForDay => attendances?.Where(a => a.Date == Date) ?? Enumerable.Empty<Attendance>();

    private string GetAttendanceColor(Attendance attendance) =>
        attendanceTypes?.FirstOrDefault(type => type.Key == attendance.AttendanceTypeKey)?.Color ?? "#808080";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter]
    public bool IsOtherMonth { get; set; } = false;

    [Parameter]
    public EventCallback AttendancesChanged { get; set; }

    private bool IsToday => Date == DateOnly.FromDateTime(DateTime.Today);


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        currentUserId = UserManager.GetUserId(authState.User);
    }


    private async Task HandleDayClickAsync(MouseEventArgs e)
    {
        if (currentUserId is null) return;

        var user = await UserManager.FindByIdAsync(currentUserId);
        if (user is null) return;

        var isCoordinator = await UserManager.IsInRoleAsync(user, IdentityDatabaseInitializer.CoordinatorRole);

        List<ApplicationUser>? users = isCoordinator ? await UserManager.Users.ToListAsync() : null;

        var result = await DialogService.ShowDialogAsync<NewAttendanceDialog>(options =>
                        {
                            options.Modal = false;
                            options.Size = DialogSize.Large;
                            options.Alignment = DialogAlignment.Default;

                            options.Parameters.Add(nameof(NewAttendanceDialog.InitialDate), Date);
                            options.Parameters.Add(nameof(NewAttendanceDialog.ApplicationUserId), currentUserId);
                            options.Parameters.Add(nameof(NewAttendanceDialog.AttendanceTypes), attendanceTypes);
                            options.Parameters.Add(nameof(NewAttendanceDialog.IsCoordinator), isCoordinator);
                            options.Parameters.Add(nameof(NewAttendanceDialog.Users), users);

                            options.Footer.PrimaryAction.Label = "Speichern";
                            options.Footer.SecondaryAction.Label = "Abbrechen";
                        });

        if (result.Cancelled)
        {
            Console.WriteLine($"Dialog Canceled: {result.Value}");
        }
        else
        {
            var dialogResult = result.Value as NewAttendanceDialogResult ?? throw new InvalidOperationException("Dialog result is not of the expected type.");

            if (dialogResult.ApplicationUserId != currentUserId && !isCoordinator)
            {
                // User is trying to add attendance for another user without being a coordinator
                Logger.LogCritical("Unauthorized attempt to add attendance for another user. UserId: {UserId}, AttemptedUserId: {AttemptedUserId}", currentUserId, dialogResult.ApplicationUserId);
                return;
            }

            await SaveAttendancesAsync(dialogResult);
        }
    }

    private async Task SaveAttendancesAsync(NewAttendanceDialogResult dialogResult)
    {
        var selectedDates = dialogResult.SelectedRangeDates.ToList();

        if (selectedDates.Count == 0)
        {
            return;
        }

        var existingAttendances = await DbContext.Attendances
            .Where(a => a.ApplicationUserId == dialogResult.ApplicationUserId && selectedDates.Contains(a.Date))
            .ToListAsync();
        var existingByDate = existingAttendances.ToDictionary(a => a.Date);
        var selectedAttendanceType = attendanceTypes?.FirstOrDefault(at => at.Key == dialogResult.AttendanceTypeKey);
        ApplicationUser? user = null;

        foreach (var date in selectedDates)
        {
            if (existingByDate.TryGetValue(date, out var existingAttendance))
            {
                existingAttendance.AttendanceTypeKey = dialogResult.AttendanceTypeKey;
                DbContext.Entry(existingAttendance).State = EntityState.Modified;

                var oldAttendance = attendances?.FirstOrDefault(a => a.Date == date && a.ApplicationUserId == dialogResult.ApplicationUserId);
                if (oldAttendance is not null)
                {
                    oldAttendance.AttendanceTypeKey = dialogResult.AttendanceTypeKey;
                    oldAttendance.AttendanceType = selectedAttendanceType ?? new AttendanceType();
                }
                continue;
            }

            var newAttendance = new Attendance
            {
                Date = date,
                ApplicationUserId = dialogResult.ApplicationUserId,
                AttendanceTypeKey = dialogResult.AttendanceTypeKey,
                AttendanceType = selectedAttendanceType ?? new AttendanceType()
            };

            user ??= await UserManager.FindByIdAsync(dialogResult.ApplicationUserId);
            if (user is not null)
            {
                newAttendance.ApplicationUser = user;
            }

            await DbContext.Attendances.AddAsync(newAttendance);
            attendances?.Add(newAttendance);
        }

        await DbContext.SaveChangesAsync();
        await AttendancesChanged.InvokeAsync();
    }

    private static IEnumerable<DateOnly> EnumerateDateRange(DateOnly startDate, DateOnly endDate)
    {
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            yield return date;
        }
    }
}
