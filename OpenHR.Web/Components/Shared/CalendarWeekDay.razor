@using System.Globalization

<div class="day @(IsOtherMonth ? "other-month" : "") @Date.ToString("dddd", CultureInfo.InvariantCulture)">@Date.ToString("dd", CultureInfo.CurrentCulture)</div>

@code {

    [Parameter, EditorRequired]
    public DateTime Date { get; set; }

    [Parameter]
    public bool IsOtherMonth { get; set; } = false;
}
