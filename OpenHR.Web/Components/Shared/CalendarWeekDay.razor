@using System.Globalization
@using Microsoft.EntityFrameworkCore;

@inject IDialogService DialogService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDbContext DbContext

@inject ILogger<CalendarWeekDay> Logger

<div class="day @(IsOtherMonth ? "other-month" : "") @Date.ToString("dddd", CultureInfo.InvariantCulture)" @onclick="HandleDayClickAsync">
    <div class="date-short">@Date.ToString("dd", CultureInfo.CurrentCulture)</div>
    <div class="date-long">@Date.ToString("D", CultureInfo.CurrentCulture)</div>

    @foreach (var attendance in AttendancesForDay)
    {
        var attendanceShortName = attendance.AttendanceType?.AttendanceShortName ?? attendance.AttendanceTypeKey.ToString();

        <div class="attendance" title="@attendanceShortName"
             style="border-color: @(GetAttendanceColor(attendance));">
            @(attendance.ApplicationUser?.ShortName ?? attendance.ApplicationUser?.UserName)
        </div>
    }
</div>



@code {
    private string? currentUserId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [CascadingParameter]
    private List<AttendanceType>? attendanceTypes { get; set; }

    [CascadingParameter]
    private List<Attendance>? attendances { get; set; }

    private IEnumerable<Attendance> AttendancesForDay => attendances?.Where(a => a.Date == Date) ?? Enumerable.Empty<Attendance>();

    private string GetAttendanceColor(Attendance attendance) =>
        attendanceTypes?.FirstOrDefault(type => type.Key == attendance.AttendanceTypeKey)?.Color ?? "#808080";

    [Parameter, EditorRequired]
    public DateOnly Date { get; set; }

    [Parameter]
    public bool IsOtherMonth { get; set; } = false;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        currentUserId = UserManager.GetUserId(authState.User);
    }


    private async Task HandleDayClickAsync(MouseEventArgs e)
    {
        if (currentUserId is null) return;

        var user = await UserManager.FindByIdAsync(currentUserId);
        if (user is null) return;

        var isCoordinator = await UserManager.IsInRoleAsync(user, IdentityDatabaseInitializer.CoordinatorRole);

        List<ApplicationUser>? users = isCoordinator ? await UserManager.Users.ToListAsync() : null;

        var result = await DialogService.ShowDialogAsync<NewAttendanceDialog>(options =>
                        {
                            options.Modal = false;
                            options.Size = DialogSize.Large;
                            options.Alignment = DialogAlignment.Default;

                            options.Parameters.Add(nameof(NewAttendanceDialog.Attendance), new Attendance { Date = Date, ApplicationUserId = currentUserId });
                            options.Parameters.Add(nameof(NewAttendanceDialog.AttendanceTypes), attendanceTypes);
                            options.Parameters.Add(nameof(NewAttendanceDialog.IsCoordinator), isCoordinator);
                            options.Parameters.Add(nameof(NewAttendanceDialog.Users), users);

                            options.Footer.PrimaryAction.Label = "Speichern";
                            options.Footer.SecondaryAction.Label = "Abbrechen";
                        });

        if (result.Cancelled)
        {
            Console.WriteLine($"Dialog Canceled: {result.Value}");
        }
        else
        {
            var attendance = result.Value as Attendance;
            if (attendance is null) return;

            if (attendance.ApplicationUserId != currentUserId && !isCoordinator)
            {
                // User is trying to add attendance for another user without being a coordinator
                Logger.LogCritical("Unauthorized attempt to add attendance for another user. UserId: {UserId}, AttemptedUserId: {AttemptedUserId}", currentUserId, attendance.ApplicationUserId);
                return;
            }

            await SaveAttendanceAsync(attendance);
        }
    }

    private async Task SaveAttendanceAsync(Attendance attendance)
    {
        var existingAttendance = await DbContext.Attendances
            .FirstOrDefaultAsync(a => a.Date == attendance.Date && a.ApplicationUserId == attendance.ApplicationUserId);

        if (existingAttendance is not null)
        {
            existingAttendance.AttendanceTypeKey = attendance.AttendanceTypeKey;
            DbContext.Entry(existingAttendance).State = EntityState.Modified;
            var oldAttendance = attendances?.FirstOrDefault(a => a.Date == attendance.Date && a.ApplicationUserId == attendance.ApplicationUserId);
            oldAttendance?.AttendanceTypeKey = attendance.AttendanceTypeKey;
            oldAttendance?.AttendanceType = attendanceTypes?.FirstOrDefault(at => at.Key == attendance.AttendanceTypeKey) ?? new AttendanceType();
        }
        else
        {
            await DbContext.Attendances.AddAsync(attendance);
            var user = await UserManager.FindByIdAsync(attendance.ApplicationUserId);
            if (user is not null) attendance.ApplicationUser = user;

            attendances?.Add(attendance);
        }

        await DbContext.SaveChangesAsync();

    }
}
