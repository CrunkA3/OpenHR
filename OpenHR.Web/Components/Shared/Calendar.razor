@using System.Globalization
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using Microsoft.EntityFrameworkCore;

@inject ApplicationDbContext DbContext


<div class="calendar">
    <CascadingValue Value="attendanceTypes">
        <CascadingValue Value="attendances">
            <div class="calendar-toolbar">
                <div class="calendar-toolbar-navigation">
                    <FluentButton Type="ButtonType.Button"
                                  OnClick="PreviousMonthAsync"
                                  IconStart="@(new Icons.Regular.Size20.ChevronLeft())"
                                  aria-label="vorheriger Monat" />
                    <FluentButton Type="ButtonType.Button"
                                  OnClick="NextMonthAsync"
                                  IconStart="@(new Icons.Regular.Size20.ChevronRight())"
                                  aria-label="nächster Monat" />
                    <FluentButton Type="ButtonType.Button"
                                  Appearance="ButtonAppearance.Primary"
                                  OnClick="GoToTodayAsync">
                        Heute
                    </FluentButton>
                </div>

                <FluentText As="TextTag.H2" Class="calendar-toolbar-title">@viewMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</FluentText>
            </div>

            <CalendarMonthHeader />

            @for (int i = 0; i < viewWeekCount; i++)
            {
                <CalendarWeek StartDate="@DateOnly.FromDateTime(viewStartDate.AddDays(i * 7))"
                              ViewMonth="@DateOnly.FromDateTime(viewMonth)"
                              AttendancesChanged="RefreshCalendarAsync" />
            }
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    private DateTime viewDate = DateTime.Today;
    private DateTime viewMonth => viewDate.StartOfMonth(CultureInfo.CurrentCulture);
    private DateTime viewStartDate => viewMonth.StartOfWeek(CultureInfo.CurrentCulture);
    private DateTime viewEndDate => viewMonth.AddMonths(1).AddDays(-1).StartOfWeek(CultureInfo.CurrentCulture).AddDays(6);
    private int viewWeekCount => (int)((viewEndDate - viewStartDate).TotalDays - 6) / 7 + 1;


    private List<AttendanceType>? attendanceTypes { get; set; }

    private List<Attendance>? attendances { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAttendanceTypesAsync();
        await LoadAttendancesAsync();
    }



    private async Task LoadAttendanceTypesAsync()
    {
        var test = DateTime.Today;
        test.StartOfMonth(CultureInfo.CurrentCulture);

        attendanceTypes = (
            await DbContext.AttendanceTypes
            .OrderBy(at => at.AttendanceName)
            .ToListAsync()
        );
    }

    private async Task LoadAttendancesAsync()
    {
        attendances = (
            await DbContext.Attendances
            .Where(a => a.Date >= DateOnly.FromDateTime(viewStartDate) && a.Date <= DateOnly.FromDateTime(viewEndDate))
            .Include(a => a.ApplicationUser)
            .ToListAsync()
        );
    }

    private async Task PreviousMonthAsync() => await SetViewDateAsync(viewDate.AddMonths(-1));

    private async Task NextMonthAsync() => await SetViewDateAsync(viewDate.AddMonths(1));

    private async Task GoToTodayAsync() => await SetViewDateAsync(DateTime.Today);

    private bool isChangingMonth;

    private async Task SetViewDateAsync(DateTime date)
    {
        if (isChangingMonth) return;

        isChangingMonth = true;
        try
        {
            viewDate = date;
            await LoadAttendancesAsync();
        }
        finally
        {
            isChangingMonth = false;
        }
    }

    private Task RefreshCalendarAsync() => InvokeAsync(StateHasChanged);

}
