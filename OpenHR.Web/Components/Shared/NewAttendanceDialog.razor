@inherits FluentDialogInstance

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<FluentDialogBody>

    <FluentStack Orientation="Orientation.Vertical">
        @if (Attendance is not null)
        {
            if (IsCoordinator && Users is not null)
            {
                <FluentSelect @bind-Value="Attendance.ApplicationUserId"
                              Items="Users"
                              TValue="string" TOption="ApplicationUser"
                              OptionText="@(item => item.ShortName ?? item.UserName)"
                              OptionValue="@(item => item.Id)"
                              Label="Benutzer"
                              Required="true" />
            }

            <FluentCalendar TValue="DateOnly"
                            SelectMode="CalendarSelectMode.Range"
                            @bind-SelectedDates="SelectedRangeDates" />

            <FluentStack Orientation="Orientation.Vertical">
                @foreach (var option in WeekdayOptions)
                {
                    <FluentCheckbox Value="@option.Selected"
                                    ValueChanged="@(value => OnWeekdaySelectionChanged(option.DayOfWeek, value))"
                                    Label="@option.Label" />
                }
            </FluentStack>

            <FluentSelect @bind-Value="Attendance.AttendanceTypeKey"
                          Items="AttendanceTypes"
                          TValue="Guid" TOption="AttendanceType"
                          OptionText="@(item => item.AttendanceName)"
                          OptionValue="@(item => item.Key!.Value)"
                          Label="Anwesenheitstyp"
                          Required="true" />
        }
    </FluentStack>
</FluentDialogBody>



@code {
    private sealed class WeekdayOption
    {
        public required DayOfWeek DayOfWeek { get; init; }
        public required string Label { get; init; }
        public bool Selected { get; set; }
    }

    private static readonly Dictionary<DayOfWeek, string> DayLabels = new()
    {
        [DayOfWeek.Monday] = "Montag",
        [DayOfWeek.Tuesday] = "Dienstag",
        [DayOfWeek.Wednesday] = "Mittwoch",
        [DayOfWeek.Thursday] = "Donnerstag",
        [DayOfWeek.Friday] = "Freitag",
        [DayOfWeek.Saturday] = "Samstag",
        [DayOfWeek.Sunday] = "Sonntag"
    };

    private readonly List<WeekdayOption> WeekdayOptions = DayLabels
        .Select(day => new WeekdayOption
        {
            DayOfWeek = day.Key,
            Label = day.Value,
            Selected = day.Key != DayOfWeek.Sunday
        })
        .OrderBy(option => option.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)option.DayOfWeek)
        .ToList();

    private IEnumerable<DateOnly> selectedRangeDates = [];
    private DateOnly? initializedFromDate;

    private IEnumerable<DateOnly> SelectedRangeDates
    {
        get => selectedRangeDates;
        set => selectedRangeDates = (value ?? [])
            .Distinct()
            .OrderBy(date => date)
            .ToList();
    }

    [Parameter]
    public Attendance? Attendance { get; set; } = default!;

    [Parameter]
    public List<AttendanceType>? AttendanceTypes { get; set; }

    [Parameter]
    public bool IsCoordinator { get; set; } = false;

    [Parameter]
    public IEnumerable<ApplicationUser>? Users { get; set; }

    protected override void OnParametersSet()
    {
        if (Attendance is null)
        {
            return;
        }

        if (initializedFromDate == Attendance.Date)
        {
            return;
        }

        SelectedRangeDates = [Attendance.Date];
        initializedFromDate = Attendance.Date;

        foreach (var option in WeekdayOptions)
        {
            option.Selected = option.DayOfWeek != DayOfWeek.Sunday;
        }
    }

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        header.Title = "Neue Anwesenheit";
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (!primary)
        {
            // Handle the cancel action
            await DialogInstance.CancelAsync();
        }
        else
        {
            if (Attendance is null)
            {
                await DialogInstance.CancelAsync();
                return;
            }

            var selectedDates = SelectedRangeDates.ToList();
            if (selectedDates.Count == 0)
            {
                await DialogInstance.CancelAsync();
                return;
            }

            var startDate = selectedDates.First();
            var endDate = selectedDates.Last();

            var selectedDays = WeekdayOptions
                .Where(option => option.Selected)
                .Select(option => option.DayOfWeek)
                .ToHashSet();

            if (selectedDays.Count == 0)
            {
                await DialogInstance.CancelAsync();
                return;
            }

            await DialogInstance.CloseAsync(new NewAttendanceDialogResult
            {
                Attendance = Attendance,
                StartDate = startDate,
                EndDate = endDate,
                SelectedDays = selectedDays
            });
        }
    }

    private void OnWeekdaySelectionChanged(DayOfWeek dayOfWeek, bool selected)
    {
        var option = WeekdayOptions.First(weekdayOption => weekdayOption.DayOfWeek == dayOfWeek);
        option.Selected = selected;
    }
}
