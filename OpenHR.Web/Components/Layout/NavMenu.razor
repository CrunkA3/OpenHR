@implements IDisposable

@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<FluentNav Id="main-menu">
    <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())" IconActive="@(new Icons.Filled.Size20.Home())">Home</FluentNavItem>
    <AuthorizeView Roles="Administrator">
        <Authorized>
            <FluentNavCategory Title="Admin" IconRest="@(new Icons.Regular.Size20.ShieldSettings())" IconActive="@(new Icons.Filled.Size20.ShieldSettings())">
                <FluentNavItem Href="admin/users" IconRest="@(new Icons.Regular.Size20.PersonAccounts())" IconActive="@(new Icons.Filled.Size20.PersonAccounts())">Benutzer</FluentNavItem>
                <FluentNavItem Href="/admin/attendance-type-management" IconRest="@(new Icons.Regular.Size20.WeatherSunnyLow())" IconActive="@(new Icons.Filled.Size20.WeatherSunnyLow())">Anwesenheitstypen</FluentNavItem>
                <FluentNavItem Href="/admin/organisation-unit-management" IconRest="@(new Icons.Regular.Size20.Organization())" IconActive="@(new Icons.Filled.Size20.Organization())">Organisationseinheiten</FluentNavItem>
            </FluentNavCategory>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="Coordinator">
        <Authorized>
            <FluentNavItem Href="/coordinator/quotas" IconRest="@(new Icons.Regular.Size20.Organization())" IconActive="@(new Icons.Filled.Size20.Organization())">Kontingente</FluentNavItem>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView>
        <Authorized>
            <FluentNavItem href="Account/Manage" IconRest="@(new Icons.Regular.Size20.Person())" IconActive="@(new Icons.Filled.Size20.Person())">
                @(user?.ShortName ?? context.User.Identity?.Name)
            </FluentNavItem>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <FluentButton Type="ButtonType.Submit" IconStart="@(new Icons.Regular.Size20.ArrowLeft())">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                </FluentButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <FluentNavItem href="Account/Login" Icon="@(new Icons.Regular.Size20.PersonGuest())">
                Anmelden
            </FluentNavItem>
        </NotAuthorized>
    </AuthorizeView>
</FluentNav>

@code {
    private string? currentUrl;

    private ApplicationUser? user;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            user = await UserManager.GetUserAsync(authState.User);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}