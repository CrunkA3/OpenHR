@implements IDisposable

@inject NavigationManager NavigationManager

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">Home</FluentNavLink>
            <FluentNavLink Href="counter" Icon="@(new Icons.Regular.Size20.NumberSymbolSquare())" IconColor="Color.Accent">Counter</FluentNavLink>
            <FluentNavLink Href="weather" Icon="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())" IconColor="Color.Accent">Weather</FluentNavLink>
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <FluentNavGroup Href="admin" Title="Admin" Icon="@(new Icons.Regular.Size20.ShieldSettings())">
                        <OpenHR.Web.Components.Pages.Admin.NavMenu />
                    </FluentNavGroup>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <FluentNavLink href="Account/Manage" Icon="@(new Icons.Regular.Size20.Person())" IconColor="Color.Accent">
                        @context.User.Identity?.Name
                    </FluentNavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <FluentButton Type="ButtonType.Submit" IconStart="@(new Icons.Regular.Size20.ArrowLeft())">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </FluentButton>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <FluentNavLink href="Account/Login" Icon="@(new Icons.Regular.Size20.PersonGuest())" IconColor="Color.Accent">
                        Anmelden
                    </FluentNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </FluentNavMenu>
    </nav>
</div>

@code {
    private string? currentUrl;

    private bool expanded = true;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
