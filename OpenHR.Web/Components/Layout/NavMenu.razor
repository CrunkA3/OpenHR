@implements IDisposable

@inject NavigationManager NavigationManager

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Default" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNav Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())">Home</FluentNavItem>
            <FluentNavItem Href="counter" IconRest="@(new Icons.Regular.Size20.NumberSymbolSquare())">Counter</FluentNavItem>
            <FluentNavItem Href="weather" IconRest="@(new Icons.Regular.Size20.WeatherPartlyCloudyDay())">Weather</FluentNavItem>
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <FluentNavCategory Title="Admin" IconRest="@(new Icons.Regular.Size20.ShieldSettings())" IconActive="@(new Icons.Regular.Size20.ShieldSettings())">
                        <FluentNavItem Href="admin/users" IconRest="@(new Icons.Regular.Size20.PersonAccounts())">Benutzer</FluentNavItem>
                        <FluentNavItem Href="/admin/attendance-type-management" IconRest="@(new Icons.Regular.Size20.SlideHide())">Anwesenheitstypen</FluentNavItem>
                        <FluentNavItem Href="/admin/organisation-unit-management" IconRest="@(new Icons.Regular.Size20.SlideHide())">Organisationseinheiten</FluentNavItem>
                    </FluentNavCategory>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <FluentNavItem href="Account/Manage" IconRest="@(new Icons.Regular.Size20.Person())">
                        @context.User.Identity?.Name
                    </FluentNavItem>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <FluentButton Type="ButtonType.Submit" IconStart="@(new Icons.Regular.Size20.ArrowLeft())">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </FluentButton>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <FluentNavItem href="Account/Login" Icon="@(new Icons.Regular.Size20.PersonGuest())">
                        Anmelden
                    </FluentNavItem>
                </NotAuthorized>
            </AuthorizeView>
        </FluentNav>
    </nav>
</div>

@code {
    private string? currentUrl;

    private bool expanded = true;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
