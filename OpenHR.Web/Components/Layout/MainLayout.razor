@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="@LayoutArea.Header">
        OpenHR
    </FluentLayoutItem>
    <FluentLayoutItem Area="@LayoutArea.Navigation">
        <NavMenu @rendermode="InteractiveServer" />
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Content">
        <div class="content">
            @Body
        </div>

    </FluentLayoutItem>

    <FluentProviders @rendermode="InteractiveServer" />

    @*     <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <FluentBodyContent Class="body-content">
        </FluentBodyContent>
    </FluentStack> *@

    <FluentLayoutItem Area="@LayoutArea.Footer">
    </FluentLayoutItem>
</FluentLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
