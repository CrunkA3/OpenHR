@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using OpenHR.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Persönliche Daten</PageTitle>

<StatusMessage />

<FluentLabel Typo="Typography.H3">Persönliche Daten</FluentLabel>

<FluentStack Orientation="Orientation.Vertical">
    <FluentLabel>Dein Konto enthält personenbezogene Daten, die du uns gegeben hast. Auf dieser Seite kannst du diese Daten herunterladen oder löschen.</FluentLabel>

    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit">Herunterladen</FluentButton>
    </form>

    <FluentLabel Weight="FontWeight.Bold">Das Löschen dieser Daten entfernt dein Konto dauerhaft und kann nicht rückgängig gemacht werden.</FluentLabel>
    <FluentAnchor Href="Account/Manage/DeletePersonalData">
        <FluentIcon Icon="Icons.Regular.Size16.Delete" Color="Color.Error" Slot="start" />
        Löschen
    </FluentAnchor>
</FluentStack>


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
