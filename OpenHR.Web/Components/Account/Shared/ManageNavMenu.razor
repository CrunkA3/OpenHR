@using Microsoft.AspNetCore.Identity
@using OpenHR.Web.Data

@inject SignInManager<ApplicationUser> SignInManager

<FluentNav>
    <FluentNavItem Href="Account/Manage" Match="NavLinkMatch.All">Profil</FluentNavItem>
    <FluentNavItem Href="Account/Manage/Email">Email</FluentNavItem>
    <FluentNavItem Href="Account/Manage/ChangePassword">Passwort</FluentNavItem>
    @if (hasExternalLogins)
    {
        <FluentNavItem Href="Account/Manage/ExternalLogins">Externe Logins</FluentNavItem>
    }
    <FluentNavItem Href="Account/Manage/TwoFactorAuthentication">2FA</FluentNavItem>
    <FluentNavItem Href="Account/Manage/Passkeys">Passkeys</FluentNavItem>
    <FluentNavItem Href="Account/Manage/PersonalData">Persönliche Daten</FluentNavItem>
</FluentNav>


@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
