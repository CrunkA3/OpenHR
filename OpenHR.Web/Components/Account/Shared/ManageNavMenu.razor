@using Microsoft.AspNetCore.Identity
@using OpenHR.Web.Data

@inject SignInManager<ApplicationUser> SignInManager

<FluentNavMenu>
    <FluentNavLink Href="Account/Manage" Match="NavLinkMatch.All">Profil</FluentNavLink>
    <FluentNavLink Href="Account/Manage/Email">Email</FluentNavLink>
    <FluentNavLink Href="Account/Manage/ChangePassword">Passwort</FluentNavLink>
    @if (hasExternalLogins)
    {
        <FluentNavLink Href="Account/Manage/ExternalLogins">Externe Logins</FluentNavLink>
    }
    <FluentNavLink Href="Account/Manage/TwoFactorAuthentication">2FA</FluentNavLink>
    <FluentNavLink Href="Account/Manage/Passkeys">Passkeys</FluentNavLink>
    <FluentNavLink Href="Account/Manage/PersonalData">Persönliche Daten</FluentNavLink>
</FluentNavMenu>


@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
