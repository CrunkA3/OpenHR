@page "/coordinator/quotas"

@attribute [Authorize(Roles = IdentityDatabaseInitializer.CoordinatorRole)]

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Kontingente</PageTitle>

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch">
    <FluentText As="TextTag.H1">Kontingente @currentYear</FluentText>
</FluentStack>

@if (items is null || FilteredItems is null)
{
    <FluentSkeleton Circular="false" Shimmer="true" Width="100%" Height="200px" />
}
else if (items.Count == 0)
{
    <FluentText>Für Ihre Organisationseinheiten wurden keine Kontingente gefunden.</FluentText>
}
else if (!FilteredItems.Any())
{
    <FluentText>Keine Einträge gefunden.</FluentText>
}
else
{
    <FluentGrid Spacing="3">
        @foreach (var item in FilteredItems)
        {
            <FluentGridItem Xs="12" Sm="6" Md="4" Lg="3">
                <FluentCard>
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalGap="10">
                        <FluentText As="TextTag.H2">@item.UserName</FluentText>

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="3">
                            @foreach (var orgUnit in item.OrganisationUnits)
                            {
                                <FluentBadge>@orgUnit</FluentBadge>
                            }
                        </FluentStack>

                        @foreach (var quota in item.Quotas)
                        {
                            <FluentField Message="@quota.AttendanceTypeName" />
                            <FluentText>Kontingent: @(quota.Quota?.ToString() ?? "Nicht festgelegt") · Verbraucht: @quota.Used.ToString("0.##") · Verbleibend: @(quota.Remaining?.ToString("0.##") ?? "–")</FluentText>
                            @if (quota.Quota is > 0)
                            {
                                <FluentProgressBar Min="0" Max="@quota.Quota" Value="@quota.Used" Width="100%" Thickness="ProgressThickness.Large" />
                            }
                        }

                    </FluentStack>
                </FluentCard>
            </FluentGridItem>
        }

    </FluentGrid>

}

@code {
    private int currentYear = DateTime.Now.Year;
    private List<UserRow>? items;

    private IQueryable<UserRow>? FilteredItems => items?.AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var coordinator = await UserManager.GetUserAsync(authenticationState.User);
        if (coordinator is null)
        {
            items = [];
            return;
        }

        var organisationUnitKeys = await DbContext.ApplicationUserOrganisationUnits
            .Where(link => link.ApplicationUserId == coordinator.Id)
            .Select(link => link.OrganisationUnitKey)
            .ToListAsync();

        var users = await DbContext.Users
            .Where(user => user.OrganisationUnitLinks.Any(link => organisationUnitKeys.Contains(link.OrganisationUnitKey)))
            .Include(user => user.OrganisationUnitLinks)
            .ThenInclude(link => link.OrganisationUnit)
            .OrderBy(user => user.Email)
            .ToListAsync();

        if (users.Count == 0)
        {
            items = [];
            return;
        }

        var userIds = users.Select(user => user.Id).ToList();
        var attendanceTypes = await DbContext.AttendanceTypes
            .Where(type => type.HasQuota == true)
            .OrderBy(type => type.AttendanceName)
            .ToListAsync();

        if (attendanceTypes.Count == 0)
        {
            items = [];
            return;
        }

        var attendanceTypeKeys = attendanceTypes
            .Where(type => type.Key.HasValue)
            .Select(type => type.Key!.Value)
            .ToList();
        var quotas = (await DbContext.ApplicationUserAttendanceQuotas
                .Where(quota => userIds.Contains(quota.ApplicationUserId)
                    && attendanceTypeKeys.Contains(quota.AttendanceTypeKey)
                    && quota.ValidFromYear <= currentYear)
                .OrderByDescending(quota => quota.ValidFromYear)
                .ToListAsync())
            .DistinctBy(quota => new { quota.ApplicationUserId, quota.AttendanceTypeKey })
            .ToDictionary(quota => (quota.ApplicationUserId, quota.AttendanceTypeKey));

        var yearStart = new DateOnly(currentYear, 1, 1);
        var yearEnd = new DateOnly(currentYear, 12, 31);
        var usage = (await DbContext.Attendances
                .Where(attendance => userIds.Contains(attendance.ApplicationUserId)
                    && attendanceTypeKeys.Contains(attendance.AttendanceTypeKey)
                    && attendance.Date >= yearStart
                    && attendance.Date <= yearEnd)
                .GroupBy(attendance => new { attendance.ApplicationUserId, attendance.AttendanceTypeKey })
                .Select(group => new
                {
                    group.Key.ApplicationUserId,
                    group.Key.AttendanceTypeKey,
                    Amount = (int)group.Sum(attendance => attendance.Amount)
                })
                .ToListAsync())
            .ToDictionary(entry => (entry.ApplicationUserId, entry.AttendanceTypeKey), entry => entry.Amount);

        var scopedOrganisationUnitKeys = organisationUnitKeys.ToHashSet();
        items = users
            .Select(user =>
            {
                var userOrganisationUnits = user.OrganisationUnitLinks
                                                    .Where(link => scopedOrganisationUnitKeys.Contains(link.OrganisationUnitKey))
                                                    .Where(link => !string.IsNullOrWhiteSpace(link.OrganisationUnit.OrganisationUnitName))
                                                    .Select(link => link.OrganisationUnit.OrganisationUnitName!)
                                                    .ToArray();

                return new UserRow(
                    string.IsNullOrWhiteSpace(user.ShortName) ? user.Email ?? user.UserName ?? string.Empty : user.ShortName,
                    userOrganisationUnits,
                    attendanceTypes.Select(type =>
                        {
                            quotas.TryGetValue((user.Id, type.Key!.Value), out var quota);
                            usage.TryGetValue((user.Id, type.Key.Value), out var used);
                            int? remaining = quota is null ? null : quota.Quota - used;

                            return new QuotaSummaryRow(
                                type.AttendanceName ?? string.Empty,
                                quota?.Quota,
                                used,
                                remaining);
                        }
                ).ToArray());
            })
            .ToList();
    }


    private sealed class UserRow(
        string userName,
        string[] organisationUnits,
        QuotaSummaryRow[] quotas)
    {
        public string UserName { get; } = userName;
        public string[] OrganisationUnits { get; } = organisationUnits;
        public QuotaSummaryRow[] Quotas { get; } = quotas;
    }

    private sealed class QuotaSummaryRow(
        string attendanceTypeName,
        int? quota,
        int used,
        int? remaining)
    {
        public string AttendanceTypeName { get; } = attendanceTypeName;
        public int? Quota { get; } = quota;
        public int Used { get; } = used;
        public int? Remaining { get; } = remaining;
    }
}
