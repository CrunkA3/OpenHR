@page "/admin/users"
@attribute [Authorize(Roles = IdentityDatabaseInitializer.AdministratorRole)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Benutzerverwaltung</PageTitle>

<h1>Benutzerverwaltung</h1>
<p>Neue Konten erhalten ein initiales Passwort und müssen es bei der ersten Anmeldung ändern.</p>
<EditForm Model="Input" method="post" FormName="create-user" OnValidSubmit="CreateUserAsync">
    <AntiforgeryToken />
    <DataAnnotationsValidator />
    <ValidationSummary />
    @if (!string.IsNullOrEmpty(message))
    {
        <p role="alert">@message</p>
    }
    <p><label>E-Mail-Adresse <InputText @bind-Value="Input.Email" autocomplete="email" /></label></p>
    <p><label>Initiales Passwort <InputText @bind-Value="Input.InitialPassword" type="password" autocomplete="new-password" /></label></p>
    <button type="submit">Benutzer anlegen</button>
</EditForm>

<h2>Bestehende Benutzer</h2>
<table>
    <thead><tr><th>E-Mail</th><th>Passwortwechsel erforderlich</th></tr></thead>
    <tbody>
        @foreach (var user in users)
        {
            <tr><td>@user.Email</td><td>@(user.MustChangePassword ? "Ja" : "Nein")</td></tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<ApplicationUser> users = [];
    private string? message;

    [SupplyParameterFromForm]
    private CreateUserInput Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadUsersAsync();
    }

    private async Task CreateUserAsync()
    {
        var user = new ApplicationUser
        {
            UserName = Input.Email,
            Email = Input.Email,
            EmailConfirmed = true,
            MustChangePassword = true
        };
        var result = await UserManager.CreateAsync(user, Input.InitialPassword);
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        message = $"Der Benutzer {user.Email} wurde angelegt.";
        Input = new();
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserManager.Users.OrderBy(user => user.Email).ToListAsync();
    }

    private sealed class CreateUserInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 12), DataType(DataType.Password)]
        public string InitialPassword { get; set; } = "";
    }
}
