@using System.ComponentModel.DataAnnotations

@inherits FluentDialogInstance
@inject INotificationService NotificationService


<FluentMessageBarProvider Section="@App.MESSAGES_DIALOG" />

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextInput Name="Content.Email" @bind-Value="Content.Email" TextFieldType="TextFieldType.Email" Label="Email" AutoComplete="none" Placeholder="Email" />
        <FluentTextInput Name="Content.InitialPassword" @bind-Value="Content.InitialPassword" TextFieldType="TextFieldType.Password" Label="Passwort" AutoComplete="none" Placeholder="Passwort" />
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public CreateUserInput Content { get; set; } = default!;

    // Initialize the dialog
    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        header.Title = "Benutzer anlegen";
        footer.SecondaryAction.Visible = true;
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (!primary)
        {
            await DialogInstance.CancelAsync();
            return;
        }

        ICollection<ValidationResult> validationResults = new List<ValidationResult>();
        var result = Validator.TryValidateObject(Content, new ValidationContext(Content), validationResults, true);

        await NotificationService.CloseAllMessageBarsAsync();


        if (!result)
        {
            foreach (var validationResult in validationResults)
            {
                await NotificationService.ShowErrorBarAsync(App.MESSAGES_DIALOG, "Validierung", validationResult.ErrorMessage ?? "Validation error");
            }

            return;
        }

        await DialogInstance.CloseAsync(Content);
    }


    public sealed class CreateUserInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, StringLength(100, MinimumLength = 12), DataType(DataType.Password)]
        public string InitialPassword { get; set; } = "";
    }


}