@page "/admin/users"

@attribute [Authorize(Roles = IdentityDatabaseInitializer.AdministratorRole)]

@rendermode InteractiveServer


@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject IDialogService DialogService
@inject ApplicationDbContext DbContext


<PageTitle>Benutzerverwaltung</PageTitle>

<FluentText As="TextTag.H1">Benutzerverwaltung</FluentText>

<FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Primary" OnClick="OpenAddUserPanel">Benutzer anlegen</FluentButton>

<FluentAccordion>
    <FluentAccordionItem Expanded="true">
        <HeaderTemplate>
            <FluentText><FluentIcon Value="@(new Icons.Regular.Size16.Filter())" Slot="start" />Filter</FluentText>
        </HeaderTemplate>
        <ChildContent>
            <FluentTextInput Autofocus=true
                             @bind-Value=emailFilter
                             @oninput="HandleEmailFilter"
                             @bind-Value:after="HandleClear"
                             Placeholder="Filter ..."
                             Style="width: 100%;"
                             Label="Email" AutoComplete="off" />
        </ChildContent>
    </FluentAccordionItem>
</FluentAccordion>

<FluentDataGrid @ref="grid" Items="FilteredItems" RowSize="DataGridRowSize.Medium" GridTemplateColumns="3fr 3fr 1fr">
    <PropertyColumn Property="@(p => p.Email)"
                    Sortable="true"
                    InitialSortDirection="DataGridSortDirection.Ascending"
                    IsDefaultSortColumn="true"
                    Filtered="!string.IsNullOrWhiteSpace(emailFilter)">
    </PropertyColumn>
    <TemplateColumn Title="Organisationseinheiten">
        <FluentAutocomplete Items="organisationUnits" TOption="OrganisationUnit" TValue="Guid?"
                            OptionText="@(ou => ou.OrganisationUnitName)"
                            OptionValue="@(ou => ou.Key)"
                            SelectedItemsChanged="@(items => HandleSelectedItemsChanged(context, items))"
                            SelectedItems="@(context.OrganisationUnitLinks.Select(ou => ou.OrganisationUnit))"
                            Placeholder="Organisationseinheiten auswählen..."
                            Width="100%" />
    </TemplateColumn>
    <TemplateColumn Title="Muss Passwort ändern">
        <FluentCheckbox Value="context.MustChangePassword" ReadOnly="true" />
    </TemplateColumn>
</FluentDataGrid>

@code {
    FluentDataGrid<ApplicationUser>? grid;

    string emailFilter = string.Empty;

    private IQueryable<ApplicationUser>? users;
    private IQueryable<OrganisationUnit>? organisationUnits;

    private string? message;


    IQueryable<ApplicationUser>? FilteredItems
    {
        get
        {
            var result = users;

            if (result is not null && !string.IsNullOrEmpty(emailFilter))
            {
                result = result.Where(c => !string.IsNullOrEmpty(c.Email) && c.Email.Contains(emailFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            return result;
        }
    }


    private AddUserPanel.CreateUserInput Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadUsersAsync();
        await LoadOrganisationUnitsAsync();
    }



    private void HandleEmailFilter(ChangeEventArgs args)
    {
        if (args.Value is string value)
        {
            emailFilter = value;
        }
    }

    private void HandleClear()
    {
        if (string.IsNullOrWhiteSpace(emailFilter))
        {
            emailFilter = string.Empty;
        }
    }




    private async Task OpenAddUserPanel(MouseEventArgs args)
    {
        AddUserPanel.CreateUserInput newUser = new();

        var result = await DialogService.ShowDrawerAsync<AddUserPanel>(options =>
        {
            options.Data = newUser;
            options.Parameters.Add(nameof(AddUserPanel.Content), newUser);
            options.Alignment = DialogAlignment.End;
            options.Header.Title = "Benutzer anlegen";
            options.Footer.PrimaryAction.Label = "Anlegen";
            options.Footer.SecondaryAction.Label = "Abbrechen";
            options.Modal = true;
        });

        if (result.Cancelled) return;

        await CreateUserAsync(result.Value as AddUserPanel.CreateUserInput);
        await LoadUsersAsync();
    }


    private async Task CreateUserAsync(AddUserPanel.CreateUserInput? newUser)
    {
        if (newUser is null) return;

        var user = new ApplicationUser
        {
            UserName = newUser.Email,
            Email = newUser.Email,
            EmailConfirmed = true,
            MustChangePassword = true
        };

        var result = await UserManager.CreateAsync(user, newUser.InitialPassword);
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        message = $"Der Benutzer {user.Email} wurde angelegt.";
        Input = new();
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = (await UserManager.Users
            .OrderBy(user => user.Email)
            .Include(user => user.OrganisationUnitLinks)
            .ThenInclude(link => link.OrganisationUnit)
            .ToListAsync()).AsQueryable();
    }

    private async Task LoadOrganisationUnitsAsync()
    {
        organisationUnits = (await DbContext.OrganisationUnits.OrderBy(ou => ou.OrganisationUnitName).ToListAsync()).AsQueryable();
    }


    /// <summary>
    /// Saves the selected organisation units for the given user.
    /// It compares the current mappings in the database with the newly selected items
    /// and updates the database accordingly by removing any mappings
    /// that are no longer selected
    /// and adding new mappings for any newly selected organisation units.
    /// </summary>
    /// <param name="user">The user for whom the organisation units are being updated.</param>
    /// <param name="selectedItems">The newly selected organisation units.</param>
    /// <returns>A task that represents the asynchronous operation.</returns>
    private async Task HandleSelectedItemsChanged(ApplicationUser user, IEnumerable<OrganisationUnit> selectedItems)
    {
        var currentMappings = await DbContext.ApplicationUserOrganisationUnits.Where(map => map.ApplicationUserId == user.Id).ToListAsync();
        var newKeys = selectedItems.Select(ou => ou.Key).ToArray();

        var deleteMappings = currentMappings.Where(map => !newKeys.Contains(map.OrganisationUnitKey)).ToList();
        var newMappings = newKeys.Where(ou => ou != null && !currentMappings.Any(map => map.OrganisationUnitKey == ou)).Select(ou => new ApplicationUserOrganisationUnit
        {
            ApplicationUserId = user.Id,
            OrganisationUnitKey = ou!.Value
        }).ToList();

        DbContext.ApplicationUserOrganisationUnits.RemoveRange(deleteMappings);
        DbContext.ApplicationUserOrganisationUnits.AddRange(newMappings);
        await DbContext.SaveChangesAsync();
    }
}

    