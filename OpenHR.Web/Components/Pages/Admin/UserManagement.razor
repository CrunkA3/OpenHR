@page "/admin/users"

@attribute [Authorize(Roles = IdentityDatabaseInitializer.AdministratorRole)]

@rendermode InteractiveServer


@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject IDialogService DialogService
@inject IMessageService MessageService


<PageTitle>Benutzerverwaltung</PageTitle>

<FluentLabel Typo="Typography.H1">Benutzerverwaltung</FluentLabel>

<FluentStack>

    <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="OpenAddUserPanel">Benutzer anlegen</FluentButton>

</FluentStack>

<FluentAccordion>

    <FluentAccordionItem Heading="Neuer Benutzer" Expanded="true">
        <p>Neue Konten erhalten ein initiales Passwort und müssen es bei der ersten Anmeldung ändern.</p>

  @*       <EditForm Model="Input" method="post" FormName="create-user" OnValidSubmit="CreateUserAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrEmpty(message))
            {
                <p role="alert">@message</p>
            }
            <FluentStack Orientation="Orientation.Vertical">
                <div>
                    <FluentTextField Name="Input.Email" @bind-Value="Input.Email" TextFieldType="TextFieldType.Email" Label="Email" AutoComplete="none" Placeholder="Email" />
                    <FluentValidationMessage For="@(() => Input.Email)" />
                </div>
                <div>
                    <FluentTextField Name="Input.InitialPassword" @bind-Value="Input.InitialPassword" TextFieldType="TextFieldType.Password" Label="Passwort" AutoComplete="none" Placeholder="Passwort" />
                    <FluentValidationMessage For="@(() => Input.InitialPassword)" />
                </div>

                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Benutzer anlegen</FluentButton>
            </FluentStack>
        </EditForm> *@
    </FluentAccordionItem>
    <FluentAccordionItem Heading="Bestehende Benutzer" Expanded="true">
        <FluentDataGrid @ref="grid" Items="FilteredItems">
           <PropertyColumn Property="@(p => p.Email)"
                            Sortable="true"
                            InitialSortDirection="SortDirection.Ascending"
                            IsDefaultSortColumn="true"
                            Filtered="!string.IsNullOrWhiteSpace(emailFilter)">                 <ColumnOptions>
                    <div class="search-box">
                        <FluentSearch Autofocus=true @bind-Value=emailFilter @oninput="HandleEmailFilter" @onkeydown="HandleCloseFilterAsync" @bind-Value:after="HandleClear" Placeholder="Email..." Style="width: 100%;" Label="Filter" />
                    </div>
                </ColumnOptions>
             </PropertyColumn> 
            <PropertyColumn Property="@(p => p.MustChangePassword)" Title="Muss Passwort ändern" Sortable="true" />
        </FluentDataGrid>
    </FluentAccordionItem>
</FluentAccordion>

@code {
    FluentDataGrid<ApplicationUser>? grid;
    private IDialogReference? _dialog;

    string emailFilter = string.Empty;

    private IQueryable<ApplicationUser>? users;
    private string? message;


    IQueryable<ApplicationUser>? FilteredItems
    {
        get
        {
            var result = users;

            if (result is not null && !string.IsNullOrEmpty(emailFilter))
            {
                result = result.Where(c => !string.IsNullOrEmpty(c.Email) && c.Email.Contains(emailFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            return result;
        }
    }


    private AddUserPanel.CreateUserInput Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadUsersAsync();
    }



    private void HandleEmailFilter(ChangeEventArgs args)
    {
        if (args.Value is string value)
        {
            emailFilter = value;
        }
    }

    private void HandleClear()
    {
        if (string.IsNullOrWhiteSpace(emailFilter))
        {
            emailFilter = string.Empty;
        }
    }

    private async Task HandleCloseFilterAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            emailFilter = string.Empty;
        }
        if (args.Key == "Enter" && grid is not null)
        {
            await grid.CloseColumnOptionsAsync();
        }
    }



    private async Task OpenAddUserPanel(MouseEventArgs args)
    {
        MessageService.Clear();

        AddUserPanel.CreateUserInput newUser = new();


        _dialog = await DialogService.ShowPanelAsync<AddUserPanel>(newUser, new DialogParameters<AddUserPanel.CreateUserInput>()
        {
            Content = newUser,
            Alignment = HorizontalAlignment.Right,
            Title = "Benutzer anlegen",
            PrimaryAction = "Anlegen",
            SecondaryAction = "Abbrechen",
            PreventDismissOnOverlayClick = true,
            ValidateDialogAsync = async () =>
            {
                ICollection<ValidationResult> validationResults = new List<ValidationResult>();
                var result = Validator.TryValidateObject(newUser, new ValidationContext(newUser), validationResults, true);

                MessageService.Clear();
                if (!result)
                {
                    foreach (var validationResult in validationResults)
                    {
                        MessageService.ShowMessageBar(options =>
                        {
                            options.Intent = MessageIntent.Error;
                            options.Title = "Validation error";
                            options.Body = validationResult.ErrorMessage ?? "Validation error";
                            options.Timestamp = DateTime.Now;
                            options.Section = App.MESSAGES_DIALOG;
                        });
                    }
                }

                await Task.Delay(100);

                return result;
            }
        });

        DialogResult result = await _dialog.Result;
    }


    private async Task CreateUserAsync()
    {
        var user = new ApplicationUser
        {
            UserName = Input.Email,
            Email = Input.Email,
            EmailConfirmed = true,
            MustChangePassword = true
        };
        var result = await UserManager.CreateAsync(user, Input.InitialPassword);
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        message = $"Der Benutzer {user.Email} wurde angelegt.";
        Input = new();
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = (await UserManager.Users.OrderBy(user => user.Email).ToListAsync()).AsQueryable();
    }
}
