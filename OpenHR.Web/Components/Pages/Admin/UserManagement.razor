@page "/admin/users"

@attribute [Authorize(Roles = IdentityDatabaseInitializer.AdministratorRole)]

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject IDialogService DialogService
@inject ApplicationDbContext DbContext


<PageTitle>Benutzerverwaltung</PageTitle>

<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
    <FluentText As="TextTag.H1">Benutzerverwaltung</FluentText>
    <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Primary" OnClick="OpenAddUserPanel">Benutzer anlegen</FluentButton>
</FluentStack>

<FluentGrid Spacing="3">

    <FluentGridItem Xs="12">
        <FluentCard>
            <FluentAccordion>
                <FluentAccordionItem Expanded="true">
                    <HeaderTemplate>
                        <FluentText><FluentIcon Value="@(new Icons.Regular.Size16.Filter())" Slot="start" />Filter</FluentText>
                    </HeaderTemplate>
                    <ChildContent>
                        <FluentTextInput @bind-Value=emailFilter
                                         @oninput="HandleEmailFilter"
                                         @bind-Value:after="HandleClear"
                                         Placeholder="Filter ..."
                                         Style="width: 100%;"
                                         Label="Email" AutoComplete="off" />
                    </ChildContent>
                </FluentAccordionItem>
            </FluentAccordion>
        </FluentCard>
    </FluentGridItem>

    @if (users is null)
    {
        <FluentSkeleton Circular="false" Shimmer="true" Width="100%" Height="200px">
        </FluentSkeleton>
    }
    else
    {
        <CascadingValue Value="organisationUnits">
            <CascadingValue Value="attendanceTypes">
                <CascadingValue Value="attendanceQuotas">
                    @foreach (var user in FilteredItems ?? Enumerable.Empty<ApplicationUser>())
                    {
                        <FluentGridItem>
                            <UserManagementItem User="user" />
                        </FluentGridItem>
                    }
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    }
</FluentGrid>


@code {
    string emailFilter = string.Empty;

    private IQueryable<ApplicationUser>? users;
    private List<OrganisationUnit>? organisationUnits;
    private List<AttendanceType>? attendanceTypes;
    private List<ApplicationUserAttendanceQuota>? attendanceQuotas;

    private string? message;


    IQueryable<ApplicationUser>? FilteredItems
    {
        get
        {
            var result = users;

            if (result is not null && !string.IsNullOrEmpty(emailFilter))
            {
                result = result.Where(c => !string.IsNullOrEmpty(c.Email) && c.Email.Contains(emailFilter, StringComparison.CurrentCultureIgnoreCase));
            }

            return result;
        }
    }


    private AddUserPanel.CreateUserInput Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        await LoadUsersAsync();
        await LoadOrganisationUnitsAsync();
        await LoadAttendanceTypesAsync();
        await LoadAttendanceQuotasAsync();
    }


    private void HandleEmailFilter(ChangeEventArgs args)
    {
        if (args.Value is string value)
        {
            emailFilter = value;
        }
    }

    private void HandleClear()
    {
        if (string.IsNullOrWhiteSpace(emailFilter))
        {
            emailFilter = string.Empty;
        }
    }




    private async Task OpenAddUserPanel(MouseEventArgs args)
    {
        AddUserPanel.CreateUserInput newUser = new();

        var result = await DialogService.ShowDrawerAsync<AddUserPanel>(options =>
        {
            options.Data = newUser;
            options.Parameters.Add(nameof(AddUserPanel.Content), newUser);
            options.Alignment = DialogAlignment.End;
            options.Header.Title = "Benutzer anlegen";
            options.Footer.PrimaryAction.Label = "Anlegen";
            options.Footer.SecondaryAction.Label = "Abbrechen";
            options.Modal = true;
        });

        if (result.Cancelled) return;

        await CreateUserAsync(result.Value as AddUserPanel.CreateUserInput);
        await LoadUsersAsync();
    }


    private async Task CreateUserAsync(AddUserPanel.CreateUserInput? newUser)
    {
        if (newUser is null) return;

        var user = new ApplicationUser
        {
            UserName = newUser.Email,
            Email = newUser.Email,
            EmailConfirmed = true,
            MustChangePassword = true
        };

        var result = await UserManager.CreateAsync(user, newUser.InitialPassword);
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        message = $"Der Benutzer {user.Email} wurde angelegt.";
        Input = new();
        await LoadUsersAsync();
    }


    private int? GetAttendanceQuota(ApplicationUser user, AttendanceType attendanceType)
    {
        return attendanceQuotas?.FirstOrDefault(q => q.ApplicationUserId == user.Id && q.AttendanceTypeKey == attendanceType.Key)?.Quota;
    }



    private async Task LoadUsersAsync()
    {
        users = (await UserManager.Users
            .OrderBy(user => user.Email)
            .Include(user => user.OrganisationUnitLinks)
            .ThenInclude(link => link.OrganisationUnit)
            .ToListAsync()).AsQueryable();
    }

    private async Task LoadOrganisationUnitsAsync() => organisationUnits = (await DbContext.OrganisationUnits.OrderBy(ou => ou.OrganisationUnitName).ToListAsync());

    private async Task LoadAttendanceTypesAsync()
    {
        attendanceTypes = (
            await DbContext.AttendanceTypes
            .Where(at => at.HasQuota!.Value)
            .OrderBy(at => at.AttendanceName)
            .ToListAsync()
        );
    }

    private async Task LoadAttendanceQuotasAsync()
    {
        attendanceQuotas = (await DbContext.ApplicationUserAttendanceQuotas
            .Where(q => q.ValidFromYear <= DateTime.Now.Year)
            .OrderByDescending(q => q.ValidFromYear)
            .ToListAsync())
            .DistinctBy(q => new { q.ApplicationUserId, q.AttendanceTypeKey })
            .ToList();
    }


}