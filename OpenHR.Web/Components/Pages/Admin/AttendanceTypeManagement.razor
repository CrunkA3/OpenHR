@page "/admin/attendance-type-management"

@attribute [Authorize(Roles = IdentityDatabaseInitializer.AdministratorRole)]

@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore;

@inject ApplicationDbContext DbContext;


<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch">

    <FluentLabel Typo="Typography.H3">Abwesenheitstypen</FluentLabel>

    <FluentButton Type="ButtonType.Button" Appearance="Appearance.Accent" OnClick="AddAttendenceRow">Abwesenheitstyp anlegen</FluentButton>
</FluentStack>

<FluentDataGrid @ref="grid" Items="FilteredItems">
    <TemplateColumn Title="Name" SortBy="sortByName">
        <FluentTextField Value="@context.AttendanceName"
                         ValueChanged="@(newValue => AttendanceNameChanged(context, newValue))"
                         Placeholder="Name..." Immediate ImmediateDelay="500" Required />
    </TemplateColumn>
    <TemplateColumn Title="Kürzel" SortBy="sortByShortName">
        <FluentTextField Value="@context.AttendanceShortName"
                         ValueChanged="@(newValue => AttendanceShortNameChanged(context, newValue))"
                         Placeholder="Kürzel..." Immediate ImmediateDelay="500" Required />
    </TemplateColumn>
    <PropertyColumn Property="@(p => p.IsAbsent)" Title="Abwesend?" Sortable="true" />
</FluentDataGrid>

@code {
    private List<AttendanceType>? items;
    private string? message;

    GridSort<AttendanceType> sortByName = GridSort<AttendanceType>.ByAscending(p => p.AttendanceName);
    GridSort<AttendanceType> sortByShortName = GridSort<AttendanceType>.ByAscending(p => p.AttendanceShortName);

    IQueryable<AttendanceType>? FilteredItems => items?.AsQueryable();

    FluentDataGrid<AttendanceType>? grid;

    protected override async Task OnInitializedAsync()
    {
        await LoadItemsAsync();
    }

    private async Task LoadItemsAsync()
    {
        items = (await DbContext.AttendanceTypes.ToListAsync());
    }

    private void AddAttendenceRow()
    {
        if (items is null)
        {
            items = new List<AttendanceType>();
        }

        items.Add(new AttendanceType { AttendanceName = "", AttendanceShortName = "", IsAbsent = false });
    }

    private async Task AttendanceNameChanged(AttendanceType item, string newValue)
    {
        item.AttendanceName = newValue;
        await SaveItemAsync(item);
    }

    private async Task AttendanceShortNameChanged(AttendanceType item, string newValue)
    {
        item.AttendanceShortName = newValue;
        await SaveItemAsync(item);
    }

    private async Task SaveItemAsync(AttendanceType item)
    {
        ICollection<ValidationResult> validationResults = new List<ValidationResult>();
        var result = Validator.TryValidateObject(item, new ValidationContext(item), validationResults, true);

        if (result)
        {
            if (!item.Key.HasValue) DbContext.Add(item);

            var e = DbContext.Entry(item);
            e.CurrentValues.SetValues(item);

            await DbContext.SaveChangesAsync();
        }
    }
}
